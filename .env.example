# TradePro Academy — Environment Variables
# Copy to .env (NEVER commit .env to git)

# ---------- server ----------
PORT=3000
NODE_ENV=production            # development | production | test
PUBLIC_URL=https://your-domain.com   # no trailing slash; used for Stripe redirects + emails
DB_PATH=./tradepro.db          # SQLite file (default: ./tradepro.db)

# ---------- sessions & cookies ----------
SESSION_SECRET=change-me-to-a-long-random-secret   # REQUIRED in production (guards refuse to boot without it)
COOKIE_SECURE=true             # true when serving over HTTPS
TRUST_PROXY=false                # true ONLY if behind a trusted reverse proxy (Render/Heroku/Nginx)

# ---------- admin bootstrap ----------
ADMIN_EMAIL=admin@tradepro.local
ADMIN_PASSWORD=                  # if empty, a random password is generated ONCE and printed to console

# ---------- Stripe ----------
STRIPE_SECRET_KEY=               # sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=           # whsec_... (REQUIRED with sk_live_)
# Currency is read from DB settings (CURRENCY_ISO, default usd); price from COURSE_PRICE.

# ---------- email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com
SMTP_SECURE=false                # true for port 465

# ---------- media protection (optional) ----------
PROTECT_MEDIA=false              # true => private MP4s served via signed, expiring URLs
MEDIA_SIGNING_SECRET=            # defaults to SESSION_SECRET if empty

# ---------- analytics (optional, consent-gated) ----------
GA4_MEASUREMENT_ID=              # G-XXXXXXXXXX
META_PIXEL_ID=

# ---------- demo / review ----------
DEMO_PURCHASE=false              # NEVER true in production — enables fake self-enrollment
